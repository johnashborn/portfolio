---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thanks for getting in touch." noindex>
  <main id="main" class="hero-glow relative -mt-16 overflow-hidden">
    <div class="container-page relative z-10 flex min-h-[70vh] flex-col items-center justify-center pt-16 text-center">
      <p class="label-mono">Message sent</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-[-0.04em] md:text-5xl">Thanks for reaching out.</h1>
      <p class="mt-4 max-w-md text-text-2">I've got your message and will reply soon — usually within a day.</p>
      <a href="/" class="mt-8 rounded-lg bg-text-1 px-4 py-2.5 text-sm font-semibold text-bg">Back to the portfolio</a>
    </div>
  </main>
</BaseLayout>
