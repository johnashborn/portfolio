---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverPlaceholder from '../../components/CoverPlaceholder.astro';
import CaseStudyToc from '../../components/CaseStudyToc.astro';
import { orderProjects, getPrevNext } from '../../lib/projects';
import { tocFromHeadings } from '../../lib/toc';

export async function getStaticPaths() {
  const ordered = orderProjects(await getCollection('projects'), { includeDrafts: import.meta.env.DEV });
  return ordered.map((project) => ({
    params: { slug: project.id },
    props: { project, ...getPrevNext(ordered, project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, summary, cover, coverAlt, year, role, timeline, type, stack, liveUrl, repoUrl } = project.data;
const { Content, headings } = await render(project);
const toc = tocFromHeadings(headings);

const typeLabel = {
  capstone: 'Capstone project',
  school: 'School project',
  personal: 'Personal project',
  client: 'Client work',
  startup: 'Startup',
}[type];

const meta = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Type', value: typeLabel },
  { label: 'Stack', value: stack.join(' · ') },
].filter((m): m is { label: string; value: string } => !!m.value);
---

<BaseLayout title={title} description={summary} image={cover?.src}>
  <main id="main">
    <header class="hero-glow relative -mt-16 overflow-hidden">
      <div class="container-page relative z-10 pt-24 md:pt-32">
        <a data-back href="/#projects" class="group inline-flex items-center gap-1.5 text-sm text-text-2 hover:text-text-1">
          <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">←</span> All projects
        </a>

        <p class="label-mono mt-10">Case study · {year}</p>
        <h1 class="mt-3 max-w-4xl break-words text-4xl font-extrabold tracking-[-0.04em] text-balance md:text-[2.75rem] md:leading-[1.08]">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-2 md:text-lg">{summary}</p>

        <dl
          data-meta
          class:list={[
            'mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line',
            // An odd last cell spans the row on mobile so no empty grey box shows.
            '[&>*:last-child:nth-child(odd)]:col-span-2 md:[&>*:last-child:nth-child(odd)]:col-span-1',
            meta.length >= 4 ? 'md:grid-cols-4' : meta.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
          ]}
        >
          {
            meta.map((m) => (
              <div class="bg-bg px-4 py-3.5">
                <dt class="label-mono text-[10px]">{m.label}</dt>
                <dd class="mt-1 text-sm text-text-1">{m.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          (liveUrl || repoUrl) && (
            <div class="mt-6 flex flex-wrap gap-3 text-sm">
              {liveUrl && (
                <a
                  data-live
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-text-1 px-4 py-2.5 font-semibold text-bg transition-transform hover:-translate-y-px"
                >
                  Live demo <span aria-hidden="true">↗</span>
                </a>
              )}
              {repoUrl && (
                <a
                  data-repo
                  href={repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-line px-4 py-2.5 text-text-1 transition-colors hover:border-zinc-500"
                >
                  Source code <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )
        }

        <div data-cover transition:name={`cover-${project.id}`} class="mt-10 overflow-hidden rounded-t-2xl border border-b-0 border-line md:mt-14">
          {
            cover ? (
              <Image
                src={cover}
                alt={coverAlt ?? title}
                widths={[800, 1200, 1600]}
                sizes="(min-width: 1152px) 1056px, 92vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-[16/9] w-full object-cover"
              />
            ) : (
              <CoverPlaceholder title={title} class="aspect-[16/7]" />
            )
          }
        </div>
      </div>
    </header>

    <div class="border-t border-zinc-900">
      <div class="container-page grid gap-10 py-14 md:py-20 lg:grid-cols-[180px_1fr] lg:gap-14">
        <CaseStudyToc items={toc} />
        <article class="prose-case min-w-0">
          <Content />
        </article>
      </div>
    </div>

    {
      prev && next && (
        <nav aria-label="More projects" class="border-t border-zinc-900">
          <div class="container-page grid grid-cols-2 gap-4 py-6 text-sm">
            <a data-prev href={`/projects/${prev.id}/`} class="group text-text-2 hover:text-text-1">
              <span class="label-mono block">Previous</span>
              <span class="mt-1 block font-semibold text-text-1">
                <span aria-hidden="true" class="inline-block transition-transform group-hover:-translate-x-0.5">←</span> {prev.data.title}
              </span>
            </a>
            <a data-next href={`/projects/${next.id}/`} class="group text-right text-text-2 hover:text-text-1">
              <span class="label-mono block">Next</span>
              <span class="mt-1 block font-semibold text-text-1">
                {next.data.title} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </a>
          </div>
        </nav>
      )
    }
  </main>
</BaseLayout>
