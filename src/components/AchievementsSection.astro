---
import { getEntry } from 'astro:content';
import { hasAchievements } from '../lib/achievements';
import SectionHeading from './SectionHeading.astro';
import StatCounter from './StatCounter.astro';

const entry = await getEntry('achievements', 'main');
const data = entry?.data;
const show = !!data && hasAchievements(data);

const statCols: Record<number, string> = {
  1: 'md:grid-cols-1',
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
};
const bothPanels = !!data && data.certifications.length > 0 && data.awards.length > 0;
---

{
  show && data && (
    <section id="achievements" aria-labelledby="achievements-title" class="border-t border-zinc-900 py-20 md:py-28">
      <div class="container-page">
        <SectionHeading index="02" label="Track record" title="Achievements" id="achievements-title" />

        {data.stats.length > 0 && (
          <div
            data-reveal
            class:list={[
              // 1px gaps over a line-coloured background draw the dividers in any column count.
              'mb-4 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:mb-5',
              '[&>*]:bg-bg [&>*:last-child:nth-child(odd)]:col-span-2 md:[&>*:last-child:nth-child(odd)]:col-span-1',
              statCols[data.stats.length],
            ]}
          >
            {data.stats.map((s) => (
              <StatCounter value={s.value} label={s.label} />
            ))}
          </div>
        )}

        <div class:list={['grid gap-4 md:gap-5', bothPanels && 'md:grid-cols-2']}>
          {data.certifications.length > 0 && (
            <div data-reveal class="rounded-2xl border border-line bg-surface-1 p-5 md:p-6">
              <h3 class="label-mono">Certifications</h3>
              <ul data-certifications class="mt-2 divide-y divide-zinc-800/80">
                {data.certifications.map((c) => (
                  <li class="flex items-center justify-between gap-4 py-3.5">
                    <div>
                      <p class="text-sm font-medium text-text-1">{c.name}</p>
                      <p class="mt-0.5 font-mono text-[11px] text-text-3">
                        {c.issuer} · {c.year}
                      </p>
                    </div>
                    {c.url && (
                      <a
                        href={c.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 rounded-md px-2 py-1 text-xs text-text-2 transition-colors hover:text-text-1"
                      >
                        Verify <span aria-hidden="true">↗</span>
                        <span class="sr-only">{c.name} (opens in a new tab)</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {data.awards.length > 0 && (
            <div data-reveal class="rounded-2xl border border-line bg-surface-1 p-5 md:p-6">
              <h3 class="label-mono">Awards &amp; hackathons</h3>
              <ul data-awards class="mt-2 divide-y divide-zinc-800/80">
                {data.awards.map((a) => (
                  <li class="flex items-start justify-between gap-4 py-3.5">
                    <div>
                      <p class="text-sm font-medium text-text-1">{a.name}</p>
                      {a.context && <p class="mt-0.5 text-[13px] text-text-2">{a.context}</p>}
                    </div>
                    <span class="shrink-0 font-mono text-[11px] text-text-3">{a.year}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  import { initCounters } from '../scripts/counter';
  document.addEventListener('astro:page-load', initCounters);
</script>
