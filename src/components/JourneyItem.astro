---
import { render, type CollectionEntry } from 'astro:content';
import { formatMonth, formatRange } from '../lib/journey';

interface Props {
  entry: CollectionEntry<'journey'>;
  latest: boolean;
}

const { entry, latest } = Astro.props;
const { type, title, place, start, end, tags } = entry.data;
const { Content } = await render(entry);

const types = {
  education: {
    label: 'Education',
    icon: 'M22 10 12 5 2 10l10 5 10-5Zm-16 2v5c3 2 9 2 12 0v-5',
  },
  org: {
    label: 'Org & leadership',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  freelance: {
    label: 'Freelance',
    icon: 'M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M4 6h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z',
  },
  milestone: {
    label: 'Milestone',
    icon: 'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09ZM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z',
  },
} as const;
const t = types[type];
---

<li data-journey-item data-reveal class="relative grid gap-1.5 pb-10 last:pb-0 md:grid-cols-[170px_1fr] md:gap-6">
  <span
    aria-hidden="true"
    class:list={[
      'journey-dot absolute top-1.5 -left-[29px] size-[11px] rounded-full border',
      latest ? 'border-white bg-white shadow-[0_0_10px_rgb(255_255_255/0.55)]' : 'border-zinc-500 bg-bg',
    ]}
  ></span>
  <p data-range class="pt-0.5 font-mono text-[11px] text-text-3">
    {type === 'milestone' && !end ? formatMonth(start) : formatRange(start, end)}
  </p>
  <div>
    <p class="mb-1.5 inline-flex items-center gap-1.5 text-[11px] text-text-3">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={t.icon}></path>
      </svg>
      <span data-type-label>{t.label}</span>
    </p>
    <h3 class="text-[15px] font-semibold">
      <span data-title>{title}</span>{place && <span class="font-normal text-text-2"> · {place}</span>}
    </h3>
    <div class="mt-1.5 text-sm leading-relaxed text-text-2 [&_p]:max-w-prose">
      <Content />
    </div>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
          {tags.map((tag) => (
            <li class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-text-2">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>
