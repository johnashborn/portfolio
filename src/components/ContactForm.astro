---
import { site } from '../site';

const fields = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
] as const;
const inputClass =
  'w-full rounded-lg border border-line bg-bg px-3.5 py-2.5 text-sm text-text-1 placeholder:text-text-3 transition-colors hover:border-zinc-600 focus:border-zinc-500 aria-[invalid=true]:border-zinc-300';
---

<div class="rounded-2xl border border-line bg-surface-1 p-5 md:p-6" data-reveal>
  <form
    name="contact"
    method="POST"
    action="/thanks"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="flex flex-col gap-4"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="sr-only" aria-hidden="true">
      <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    {
      fields.map((f) => (
        <div>
          <label for={`contact-${f.name}`} class="mb-1.5 block text-xs font-medium text-text-2">
            {f.label}
          </label>
          <input
            id={`contact-${f.name}`}
            name={f.name}
            type={f.type}
            autocomplete={f.autocomplete}
            required
            aria-describedby={`contact-${f.name}-error`}
            class={inputClass}
          />
          <p id={`contact-${f.name}-error`} class="mt-1.5 text-xs text-zinc-300 empty:hidden" />
        </div>
      ))
    }

    <div>
      <label for="contact-message" class="mb-1.5 block text-xs font-medium text-text-2">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        aria-describedby="contact-message-error"
        class:list={[inputClass, 'resize-y']}></textarea>
      <p id="contact-message-error" class="mt-1.5 text-xs text-zinc-300 empty:hidden"></p>
    </div>

    <p data-form-error role="alert" hidden class="rounded-lg border border-line bg-bg px-3.5 py-2.5 text-sm text-text-2">
      Sorry — the message couldn't be sent. Please try again, or email me directly at
      <a href={`mailto:${site.email}`} class="text-text-1 underline underline-offset-2">{site.email}</a>.
    </p>

    <button
      type="submit"
      class="mt-1 rounded-lg bg-text-1 px-4 py-2.5 text-sm font-semibold text-bg transition-[transform,opacity] hover:-translate-y-px disabled:pointer-events-none disabled:opacity-70"
    >
      Send message
    </button>
  </form>

  <div data-form-success hidden tabindex="-1" aria-live="polite" class="py-10 text-center focus:outline-none">
    <p class="text-lg font-semibold text-text-1">Thanks — message sent.</p>
    <p class="mt-2 text-sm text-text-2">I'll get back to you soon, usually within a day.</p>
  </div>
</div>
